# ==============================================================================
# CORTEX CONFIGURATION
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# DATABASE_MODE: 'embedded' (zero-install local PGlite/disk, no Docker needed)
#                'postgres' (production PostgreSQL instance / Docker)
DATABASE_MODE=embedded
DATABASE_PATH=./data/cortex_db
DATABASE_URL=postgresql://cortex:cortex_secret@localhost:5432/cortex_db

# ------------------------------------------------------------------------------
# 2. VECTOR DATABASE CONFIGURATION (Qdrant)
# ------------------------------------------------------------------------------
# VECTOR_STORE_MODE: 'embedded' (local memory/disk vector index, no Docker needed)
#                    'qdrant'   (Qdrant server / Docker container / Qdrant Cloud)
VECTOR_STORE_MODE=embedded
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=cortex_code_chunks

# ------------------------------------------------------------------------------
# 3. CACHE & QUEUE CONFIGURATION (Redis & BullMQ)
# ------------------------------------------------------------------------------
# REDIS_MODE: 'embedded' (in-memory cache & lightweight queue, no Docker needed)
#             'redis'    (Redis 7 server / Docker container)
REDIS_MODE=embedded
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 4. EMBEDDING PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# EMBEDDING_PROVIDER: 'local'  (100% Free, runs on CPU via @xenova/transformers, $0.00)
#                     'openai' (OpenAI text-embedding-3-small)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# Optional OpenAI Key (if EMBEDDING_PROVIDER=openai or LLM_PROVIDER=openai)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 5. LLM SYNTHESIS PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# LLM_PROVIDER: 'groq'   (Recommended: 100% Free tier, ultra-fast 300+ tok/s)
#               'ollama' (100% local, requires Ollama running on localhost:11434)
#               'openai' (Paid OpenAI GPT-4o-mini)
LLM_PROVIDER=groq

# Groq API Configuration (Free tier: https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Configuration (Only if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ------------------------------------------------------------------------------
# 6. MODEL CONTEXT PROTOCOL (MCP) CONFIGURATION
# ------------------------------------------------------------------------------
MCP_SERVER_NAME=cortex-mcp
MCP_SERVER_VERSION=1.0.0
MCP_PORT=3001
MCP_TRANSPORT=stdio
